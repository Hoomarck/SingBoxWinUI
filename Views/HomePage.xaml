<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SingBoxWinUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <Grid Padding="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 卡片按内容高度排布，不再被拉伸成大片空白 -->
            <RowDefinition Height="Auto" />
            <!-- 连接性检测与出口信息 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 状态卡片：只保留状态、配置与启停总开关 -->
        <Border
            Grid.Row="0"
            Padding="20,16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ConfigSummary, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ConfigPath, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="16"
                    VerticalAlignment="Center">
                    <Button
                        Content="{x:Bind Loc.HomeManageProfiles, Mode=OneWay}"
                        Click="OnManageProfilesClick" />

                    <ToggleSwitch
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OnContent=""
                        OffContent=""
                        AutomationProperties.Name="{x:Bind Loc.HomeToggleCore, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsToggleEnabled, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.IsRunning, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 当前订阅信息 -->
        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Padding="20,14"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="10">

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Loc.HomeCurrentProfile, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SubscriptionName, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="360" />
                        <Border
                            Padding="6,1"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock
                                Text="{x:Bind ViewModel.SubscriptionTypeText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Click="OnUpdateSubscriptionClick"
                        IsEnabled="{x:Bind ViewModel.CanUpdateSubscription, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Loc.HomeUpdateProfile, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="{x:Bind Loc.HomeUpdateProfile, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2" HorizontalAlignment="Left">
                        <TextBlock
                            Text="{x:Bind Loc.HomeUpdatedAt, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SubscriptionUpdateText, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Left">
                        <TextBlock
                            Text="{x:Bind Loc.HomeExpiresAt, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SubscriptionExpireText, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Left">
                        <TextBlock
                            Text="{x:Bind Loc.HomeUsedTotal, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SubscriptionTrafficText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasSubscriptionTraffic, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar
                        Grid.Column="0"
                        Minimum="0"
                        Maximum="100"
                        VerticalAlignment="Center"
                        Value="{x:Bind ViewModel.SubscriptionUsagePercent, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Loc.HomeUsageA11y, Mode=OneWay}" />

                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.SubscriptionUsagePercentText, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 非管理员提示 -->
        <!-- 非管理员提示：自定义条，避免 InfoBar 在深色主题下背景/文字对比度失控 -->
        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="16,10"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="{x:Bind ViewModel.ShowAdminHint, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    Glyph="&#xE7BA;"
                    FontSize="16"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Loc.HomeTunAdminHint, Mode=OneWay}"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <Button
                    Grid.Column="2"
                    Content="{x:Bind Loc.HomeRestartAsAdmin, Mode=OneWay}"
                    Click="OnElevateClick" />

                <Button
                    Grid.Column="3"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnDismissAdminHintClick"
                    AutomationProperties.Name="{x:Bind Loc.HomeDismiss, Mode=OneWay}">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <!-- 代理模式 / 网络设置 -->
        <Grid
            Grid.Row="3"
            Margin="0,12,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="20,16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Loc.HomeProxyMode, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind Loc.HomeProxyModeHint, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton
                            Content="{x:Bind Loc.HomeModeRule, Mode=OneWay}"
                            MinWidth="0"
                            GroupName="ClashMode"
                            Tag="Rule"
                            AutomationProperties.Name="{x:Bind Loc.HomeModeRuleA11y, Mode=OneWay}"
                            Checked="OnClashModeChecked"
                            IsChecked="{x:Bind IsMode(0, ViewModel.ClashModeIndex), Mode=OneWay}" />
                        <RadioButton
                            Content="{x:Bind Loc.HomeModeGlobal, Mode=OneWay}"
                            MinWidth="0"
                            GroupName="ClashMode"
                            Tag="Global"
                            AutomationProperties.Name="{x:Bind Loc.HomeModeGlobalA11y, Mode=OneWay}"
                            Checked="OnClashModeChecked"
                            IsChecked="{x:Bind IsMode(1, ViewModel.ClashModeIndex), Mode=OneWay}" />
                        <RadioButton
                            Content="{x:Bind Loc.HomeModeDirect, Mode=OneWay}"
                            MinWidth="0"
                            GroupName="ClashMode"
                            Tag="Direct"
                            AutomationProperties.Name="{x:Bind Loc.HomeModeDirectA11y, Mode=OneWay}"
                            Checked="OnClashModeChecked"
                            IsChecked="{x:Bind IsMode(2, ViewModel.ClashModeIndex), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Padding="20,16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind Loc.HomeNetworkSettings, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Loc.HomeSystemProxy, Mode=OneWay}" VerticalAlignment="Center" />
                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            OnContent=""
                            OffContent=""
                            AutomationProperties.Name="{x:Bind Loc.HomeSystemProxyA11y, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.IsSystemProxyEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Loc.HomeTunMode, Mode=OneWay}" VerticalAlignment="Center" />
                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            OnContent=""
                            OffContent=""
                            AutomationProperties.Name="{x:Bind Loc.HomeTunModeA11y, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.IsTunEnabled, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>


        <!-- 网络连通性与出口信息（Fluent card） -->
        <Border
            Grid.Row="4"
            Margin="0,12,0,0"
            Padding="20,16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind Loc.ConnCardTitle, Mode=OneWay}"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind Loc.ConnExitIp, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            Text="{x:Bind ViewModel.ExitIpText, Mode=OneWay}"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            FontFamily="Consolas"
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="True" />
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.ToggleIpMaskCommand, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.IpMaskHint, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.IpMaskHint, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.IpMaskGlyph, Mode=OneWay}" FontSize="14" />
                        </Button>
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.CopyExitIpCommand, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Loc.ConnCopyIp, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Loc.ConnCopyIp, Mode=OneWay}">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Text="{x:Bind ViewModel.ExitRegionText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ConnectivityHintText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsCheckingConnectivity, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsCheckingConnectivity, Mode=OneWay}" />
                        <Button
                            Content="{x:Bind Loc.ConnRecheck, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CheckConnectivityCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanCheckConnectivity, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Border
                            Padding="10,4"
                            CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            AutomationProperties.Name="{x:Bind Loc.ConnLatencyA11y, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="{x:Bind Loc.ConnGoogle, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.GoogleLatencyText, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind ViewModel.GoogleLatencyBrush, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="10,4"
                            CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="{x:Bind Loc.ConnGithub, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.GitHubLatencyText, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind ViewModel.GitHubLatencyBrush, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="10,4"
                            CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="{x:Bind Loc.ConnCloudflare, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.CloudflareLatencyText, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind ViewModel.CloudflareLatencyBrush, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        </Grid>
    </ScrollViewer>
</Page>
