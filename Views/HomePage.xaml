<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SingBoxWinUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <Grid Padding="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 卡片按内容高度排布，不再被拉伸成大片空白 -->
            <RowDefinition Height="Auto" />
            <!-- 连接性检测与出口信息 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部状态卡片：左侧状态主标题与订阅摘要，右侧系统代理 / TUN 双开关 + 管理订阅 -->
        <Border
            Grid.Row="0"
            Padding="20,16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                        Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ConfigSummary, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ConfigPath, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind Loc.HomeSwitchHint, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- 热重启期间不绑定 IsEnabled：开关保持可用，避免点击时灰白闪烁 -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="16"
                    VerticalAlignment="Center">

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Loc.HomeSystemProxy, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center" />
                        <ToggleSwitch
                            MinWidth="0"
                            HorizontalAlignment="Center"
                            OnContent=""
                            OffContent=""
                            AutomationProperties.Name="{x:Bind Loc.HomeSystemProxyA11y, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.IsSystemProxyEnabled, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Loc.HomeTunMode, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center" />
                        <ToggleSwitch
                            MinWidth="0"
                            HorizontalAlignment="Center"
                            OnContent=""
                            OffContent=""
                            AutomationProperties.Name="{x:Bind Loc.HomeTunModeA11y, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.IsTunEnabled, Mode=TwoWay}" />
                    </StackPanel>

                    <Button
                        VerticalAlignment="Center"
                        Content="{x:Bind Loc.HomeManageProfiles, Mode=OneWay}"
                        Click="OnManageProfilesClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 当前订阅信息 -->
        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Padding="20,14"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="10">

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Loc.HomeCurrentProfile, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SubscriptionName, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="360" />
                        <Border
                            Padding="6,1"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock
                                Text="{x:Bind ViewModel.SubscriptionTypeText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Click="OnUpdateSubscriptionClick"
                        IsEnabled="{x:Bind ViewModel.CanUpdateSubscription, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Loc.HomeUpdateProfile, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="{x:Bind Loc.HomeUpdateProfile, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2" HorizontalAlignment="Left">
                        <TextBlock
                            Text="{x:Bind Loc.HomeUpdatedAt, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SubscriptionUpdateText, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Left">
                        <TextBlock
                            Text="{x:Bind Loc.HomeExpiresAt, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SubscriptionExpireText, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Left">
                        <TextBlock
                            Text="{x:Bind Loc.HomeUsedTotal, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SubscriptionTrafficText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasSubscriptionTraffic, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar
                        Grid.Column="0"
                        Minimum="0"
                        Maximum="100"
                        VerticalAlignment="Center"
                        Value="{x:Bind ViewModel.SubscriptionUsagePercent, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Loc.HomeUsageA11y, Mode=OneWay}" />

                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.SubscriptionUsagePercentText, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 非管理员提示 -->
        <!-- 非管理员提示：自定义条，避免 InfoBar 在深色主题下背景/文字对比度失控 -->
        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="16,10"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="{x:Bind ViewModel.ShowAdminHint, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    Glyph="&#xE7BA;"
                    FontSize="16"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Loc.HomeTunAdminHint, Mode=OneWay}"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <Button
                    Grid.Column="2"
                    Content="{x:Bind Loc.HomeRestartAsAdmin, Mode=OneWay}"
                    Click="OnElevateClick" />

                <Button
                    Grid.Column="3"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnDismissAdminHintClick"
                    AutomationProperties.Name="{x:Bind Loc.HomeDismiss, Mode=OneWay}">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <!-- 代理模式：通栏卡片（原 Network Settings 已并入顶部状态卡片） -->
        <Border
            Grid.Row="3"
            Margin="0,12,0,0"
            Padding="20,16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Loc.HomeProxyMode, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind Loc.HomeProxyModeHint, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton
                        Content="{x:Bind Loc.HomeModeRule, Mode=OneWay}"
                        MinWidth="0"
                        GroupName="ClashMode"
                        Tag="Rule"
                        AutomationProperties.Name="{x:Bind Loc.HomeModeRuleA11y, Mode=OneWay}"
                        Checked="OnClashModeChecked"
                        IsChecked="{x:Bind IsMode(0, ViewModel.ClashModeIndex), Mode=OneWay}" />
                    <RadioButton
                        Content="{x:Bind Loc.HomeModeGlobal, Mode=OneWay}"
                        MinWidth="0"
                        GroupName="ClashMode"
                        Tag="Global"
                        AutomationProperties.Name="{x:Bind Loc.HomeModeGlobalA11y, Mode=OneWay}"
                        Checked="OnClashModeChecked"
                        IsChecked="{x:Bind IsMode(1, ViewModel.ClashModeIndex), Mode=OneWay}" />
                    <RadioButton
                        Content="{x:Bind Loc.HomeModeDirect, Mode=OneWay}"
                        MinWidth="0"
                        GroupName="ClashMode"
                        Tag="Direct"
                        AutomationProperties.Name="{x:Bind Loc.HomeModeDirectA11y, Mode=OneWay}"
                        Checked="OnClashModeChecked"
                        IsChecked="{x:Bind IsMode(2, ViewModel.ClashModeIndex), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>


        <!-- 网络连通性与出口信息（双通道 × 双栈，Fluent card） -->
        <Border
            Grid.Row="4"
            Margin="0,12,0,0"
            Padding="20,16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="14">

                <!-- 头部：标题 + 状态副标题；右侧打码 / 进度 / 立即检测 -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Loc.ConnCardTitle, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ConnectivityHintText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.ToggleIpMaskCommand, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.IpMaskHint, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.IpMaskHint, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.IpMaskGlyph, Mode=OneWay}" FontSize="14" />
                        </Button>
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsCheckingConnectivity, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsCheckingConnectivity, Mode=OneWay}" />
                        <Button
                            Content="{x:Bind Loc.ConnRecheck, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CheckConnectivityCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanCheckConnectivity, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- 延迟胶囊（经代理探测） -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        Padding="10,4"
                        CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        AutomationProperties.Name="{x:Bind Loc.ConnLatencyA11y, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                Text="{x:Bind Loc.ConnGoogle, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.GoogleLatencyText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind ViewModel.GoogleLatencyBrush, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="10,4" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                Text="{x:Bind Loc.ConnGithub, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.GitHubLatencyText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind ViewModel.GitHubLatencyBrush, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="10,4" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                Text="{x:Bind Loc.ConnCloudflare, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.CloudflareLatencyText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind ViewModel.CloudflareLatencyBrush, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 双通道对比：两列等宽 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：国内直连（不经代理） -->
                    <Border
                        Grid.Column="0"
                        Padding="14,12"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Text="{x:Bind Loc.ConnDirectTitle, Mode=OneWay}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    VerticalAlignment="Center" />
                                <Border
                                    Padding="6,1"
                                    CornerRadius="4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind Loc.ConnDirectTag, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- 直连 IPv4 -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="IPv4"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.DirectIpv4Text, Mode=OneWay}"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        IsTextSelectionEnabled="True"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.DirectIpv4Text, Mode=OneWay}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.DirectIpv4RegionText, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind ViewModel.HasDirectIpv4, Mode=OneWay}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsEnabled="{x:Bind ViewModel.HasDirectIpv4, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.CopyIpCommand, Mode=OneWay}"
                                    CommandParameter="direct-v4"
                                    AutomationProperties.Name="{x:Bind Loc.ConnCopyIp, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind Loc.ConnCopyIp, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                </Button>
                            </Grid>

                            <!-- 直连 IPv6（无公网 v6 时安静显示占位符） -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="IPv6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.DirectIpv6Text, Mode=OneWay}"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        IsTextSelectionEnabled="True"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.DirectIpv6Text, Mode=OneWay}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.DirectIpv6RegionText, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind ViewModel.HasDirectIpv6, Mode=OneWay}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsEnabled="{x:Bind ViewModel.HasDirectIpv6, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.CopyIpCommand, Mode=OneWay}"
                                    CommandParameter="direct-v6"
                                    AutomationProperties.Name="{x:Bind Loc.ConnCopyIp, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind Loc.ConnCopyIp, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 右：代理出口（经代理） -->
                    <Border
                        Grid.Column="1"
                        Padding="14,12"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Text="{x:Bind Loc.ConnProxyTitle, Mode=OneWay}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    VerticalAlignment="Center" />
                                <Border
                                    Padding="6,1"
                                    CornerRadius="4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind Loc.ConnProxyTag, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- 代理 IPv4 -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="IPv4"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ProxyIpv4Text, Mode=OneWay}"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        IsTextSelectionEnabled="True"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ProxyIpv4Text, Mode=OneWay}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ProxyIpv4RegionText, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind ViewModel.HasProxyIpv4, Mode=OneWay}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsEnabled="{x:Bind ViewModel.HasProxyIpv4, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.CopyIpCommand, Mode=OneWay}"
                                    CommandParameter="proxy-v4"
                                    AutomationProperties.Name="{x:Bind Loc.ConnCopyIp, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind Loc.ConnCopyIp, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                </Button>
                            </Grid>

                            <!-- 代理 IPv6 -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="IPv6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ProxyIpv6Text, Mode=OneWay}"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        IsTextSelectionEnabled="True"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ProxyIpv6Text, Mode=OneWay}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ProxyIpv6RegionText, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind ViewModel.HasProxyIpv6, Mode=OneWay}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsEnabled="{x:Bind ViewModel.HasProxyIpv6, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.CopyIpCommand, Mode=OneWay}"
                                    CommandParameter="proxy-v6"
                                    AutomationProperties.Name="{x:Bind Loc.ConnCopyIp, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind Loc.ConnCopyIp, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                </Button>
                            </Grid>

                            <TextBlock
                                Text="{x:Bind Loc.ConnProxyUnavailable, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind ViewModel.ProxyUnavailable, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        </Grid>
    </ScrollViewer>
</Page>
