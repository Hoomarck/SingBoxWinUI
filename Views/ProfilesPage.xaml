<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SingBoxWinUI.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SingBoxWinUI.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部操作区 -->
        <Border
            Grid.Row="0"
            Padding="20,16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="12">
                <!-- 标题行：左标题 + 右侧操作，用两列避免互相压盖 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Bind Loc.NavProfiles, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        VerticalAlignment="Center" />

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button Content="{x:Bind Loc.ProfilesImportLocal, Mode=OneWay}" Click="OnImportLocalClick" />
                        <Button
                            Content="{x:Bind Loc.ProfilesUpdateAll, Mode=OneWay}"
                            Command="{x:Bind ViewModel.UpdateAllCommand, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- 表单：名称列弹性伸缩，周期与按钮固定宽度，窄窗口也不会溢出 -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        PlaceholderText="{x:Bind Loc.ProfilesNewName, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Loc.ProfilesNewNameA11y, Mode=OneWay}"
                        Text="{x:Bind ViewModel.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ComboBox
                        Grid.Column="1"
                        MinWidth="140"
                        AutomationProperties.Name="{x:Bind Loc.ProfilesIntervalA11y, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.IntervalOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.NewIntervalIndex, Mode=TwoWay}">
                                </ComboBox>

                    <Button
                        Grid.Column="2"
                        Content="{x:Bind Loc.ProfilesImportRemote, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ImportOnlineCommand, Mode=OneWay}" />
                </Grid>

                <TextBox
                    PlaceholderText="{x:Bind Loc.ProfilesNewUrl, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Loc.ProfilesNewUrlA11y, Mode=OneWay}"
                    Text="{x:Bind ViewModel.NewUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Informational"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- 全局拓展配置（Mixin） -->
        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Padding="20,16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind Loc.ProfilesMixinTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 前置 -->
                    <Border
                        Grid.Column="0"
                        Padding="14,12"
                        CornerRadius="6"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock
                                    Text="{x:Bind Loc.ProfilesPreMixin, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                                <ToggleSwitch
                                    HorizontalAlignment="Right"
                                    MinWidth="0"
                                    OnContent=""
                                    OffContent=""
                                    AutomationProperties.Name="{x:Bind Loc.ProfilesEnablePreA11y, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.EnablePreMixin, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock
                                Text="{x:Bind Loc.ProfilesPreMixinHint, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Button
                                Content="{x:Bind Loc.ProfilesEditPreJson, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                Click="OnEditPreMixinClick" />
                        </StackPanel>
                    </Border>

                    <!-- 后置 -->
                    <Border
                        Grid.Column="1"
                        Padding="14,12"
                        CornerRadius="6"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock
                                    Text="{x:Bind Loc.ProfilesPostMixin, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                                <ToggleSwitch
                                    HorizontalAlignment="Right"
                                    MinWidth="0"
                                    OnContent=""
                                    OffContent=""
                                    AutomationProperties.Name="{x:Bind Loc.ProfilesEnablePostA11y, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.EnablePostMixin, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock
                                Text="{x:Bind Loc.ProfilesPostMixinHint, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Button
                                Content="{x:Bind Loc.ProfilesEditPostJson, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                Click="OnEditPostMixinClick" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 订阅卡片列表 -->
        <ScrollViewer
            Grid.Row="2"
            Margin="0,12,0,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ProfileItem">
                        <Grid Margin="0,0,0,8">
                            <Border
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

                            <Border
                                CornerRadius="8"
                                BorderThickness="2"
                                IsHitTestVisible="False"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind IsActive, Mode=OneWay}" />

                            <StackPanel Padding="16,12" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind Name, Mode=OneWay}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        VerticalAlignment="Center" />

                                    <Border
                                        Padding="6,1"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock
                                            Text="{x:Bind TypeText, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>

                                    <Border
                                        Padding="6,1"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay}">
                                        <TextBlock
                                            Text="{x:Bind Loc.ProfilesInUse, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    Text="{x:Bind MetaText, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Content="{x:Bind Loc.ProfilesEnable, Mode=OneWay}"
                                        Tag="{x:Bind}"
                                        Click="OnEnableClick" />
                                    <Button
                                        Content="{x:Bind Loc.ProfilesUpdateNow, Mode=OneWay}"
                                        Tag="{x:Bind}"
                                        Click="OnUpdateClick"
                                        Visibility="{x:Bind CanUpdate, Mode=OneWay}" />
                                    <Button
                                        Content="{x:Bind Loc.ProfilesRenameEdit, Mode=OneWay}"
                                        Tag="{x:Bind}"
                                        Click="OnEditClick" />
                                    <Button
                                        Content="{x:Bind Loc.CommonDelete, Mode=OneWay}"
                                        Tag="{x:Bind}"
                                        Click="OnDeleteClick" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
