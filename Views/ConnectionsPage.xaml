<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SingBoxWinUI.Views.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SingBoxWinUI.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="24,8,24,24">

        <!-- 未运行空状态 -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            Visibility="{x:Bind ViewModel.IsNotRunning, Mode=OneWay}">
            <FontIcon
                Glyph="&#xE774;"
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                Text="{x:Bind Loc.ProxiesStartCoreFirst, Mode=OneWay}"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 运行中 -->
        <Grid Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部控制卡片 -->
            <Border
                Grid.Row="0"
                Padding="20,16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="16"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ViewModel.ConnectionCountText, Mode=OneWay}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.TotalSpeedText, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.TotalTrafficText, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <ToggleButton
                                Content="{x:Bind Loc.ConnPause, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind Loc.ConnPause, Mode=OneWay}"
                                IsChecked="{x:Bind ViewModel.IsPaused, Mode=TwoWay}" />

                            <Button Content="{x:Bind Loc.ConnShowColumns, Mode=OneWay}">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Width="200" Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind Loc.ConnShowColumns, Mode=OneWay}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Margin="0,0,0,6" />
                                            <CheckBox
                                                Content="{x:Bind Loc.ConnColInbound, Mode=OneWay}"
                                                IsChecked="{x:Bind ViewModel.Columns.ShowInbound, Mode=TwoWay}" />
                                            <CheckBox
                                                Content="{x:Bind Loc.ConnColProcess, Mode=OneWay}"
                                                IsChecked="{x:Bind ViewModel.Columns.ShowProcess, Mode=TwoWay}" />
                                            <CheckBox
                                                Content="{x:Bind Loc.ConnColRule, Mode=OneWay}"
                                                IsChecked="{x:Bind ViewModel.Columns.ShowRule, Mode=TwoWay}" />
                                            <CheckBox
                                                Content="{x:Bind Loc.ConnColChain, Mode=OneWay}"
                                                IsChecked="{x:Bind ViewModel.Columns.ShowChains, Mode=TwoWay}" />
                                            <CheckBox
                                                Content="{x:Bind Loc.ConnColSpeedTotal, Mode=OneWay}"
                                                IsChecked="{x:Bind ViewModel.Columns.ShowSpeed, Mode=TwoWay}" />
                                            <CheckBox
                                                Content="{x:Bind Loc.ConnColTrafficTotal, Mode=OneWay}"
                                                IsChecked="{x:Bind ViewModel.Columns.ShowTraffic, Mode=TwoWay}" />
                                            <CheckBox
                                                Content="{x:Bind Loc.ConnColDestinationIp, Mode=OneWay}"
                                                IsChecked="{x:Bind ViewModel.Columns.ShowIp, Mode=TwoWay}" />
                                            <CheckBox
                                                Content="{x:Bind Loc.ConnColDuration, Mode=OneWay}"
                                                IsChecked="{x:Bind ViewModel.Columns.ShowDuration, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button
                                Content="{x:Bind Loc.ConnCloseAll, Mode=OneWay}"
                                Click="OnCloseAllClick" />
                        </StackPanel>
                    </Grid>

                    <!-- 搜索独占一行，避免窄窗口下被固定宽度控件挤成 0 -->
                    <TextBox
                        PlaceholderText="{x:Bind Loc.ConnSearchPlaceholder, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Loc.ConnSearchA11y, Mode=OneWay}"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            Grid.Column="0"
                            Width="170"
                            AutomationProperties.Name="{x:Bind Loc.ConnOutboundFilterA11y, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.OutboundOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedOutbound, Mode=TwoWay}" />

                        <ComboBox
                            Grid.Column="1"
                            Width="150"
                            AutomationProperties.Name="{x:Bind Loc.ConnSortByA11y, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.SortModeOptions, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SortModeIndex, Mode=TwoWay}">
                                </ComboBox>

                        <Button
                            Grid.Column="2"
                            Width="48"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind Loc.ProxiesToggleSortA11y, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Loc.ProxiesToggleSort, Mode=OneWay}"
                            Content="{x:Bind ViewModel.SortDirectionText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleSortDirectionCommand, Mode=OneWay}" />
                    </Grid>

                </StackPanel>
            </Border>

            <!-- 连接列表 -->
            <Grid Grid.Row="1" Margin="0,12,0,0">

                <TextBlock
                    Text="{x:Bind ViewModel.EmptyHintText, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{x:Bind ViewModel.HasNoConnections, Mode=OneWay}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConnectionItem">
                                <Grid>
                                    <Border
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

                                    <StackPanel Padding="16,10" Spacing="8">

                                        <!-- 主行：目标地址 + 实时速度 + 断开 -->
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel
                                                Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{x:Bind Target, Mode=OneWay}"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    TextTrimming="CharacterEllipsis"
                                                    MaxWidth="420"
                                                    VerticalAlignment="Center" />
                                                <Border
                                                    Padding="8,2"
                                                    CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind Columns.ShowInbound, Mode=OneWay}">
                                                    <TextBlock
                                                        Text="{x:Bind InboundText, Mode=OneWay}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind SpeedText, Mode=OneWay}"
                                                VerticalAlignment="Center"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Visibility="{x:Bind Columns.ShowSpeed, Mode=OneWay}" />

                                            <Button
                                                Grid.Column="2"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                Tag="{x:Bind}"
                                                Click="OnCloseConnectionClick"
                                                AutomationProperties.Name="{x:Bind Loc.ConnCloseA11y, Mode=OneWay}"
                                                Background="Transparent"
                                                BorderThickness="0">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                                            </Button>
                                        </Grid>

                                        <!-- 次要信息徽标 -->
                                        <Grid RowSpacing="6" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,2"
                                                CornerRadius="4"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind Columns.ShowProcess, Mode=OneWay}">
                                                <TextBlock
                                                    Text="{x:Bind ProcessText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxWidth="220"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="8,2"
                                                CornerRadius="4"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind Columns.ShowRule, Mode=OneWay}">
                                                <TextBlock
                                                    Text="{x:Bind RuleText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxWidth="260"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Padding="8,2"
                                                CornerRadius="4"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind Columns.ShowChains, Mode=OneWay}">
                                                <TextBlock
                                                    Text="{x:Bind ChainsText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxWidth="280"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Padding="8,2"
                                                CornerRadius="4"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind Columns.ShowTraffic, Mode=OneWay}">
                                                <TextBlock
                                                    Text="{x:Bind TrafficText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Padding="8,2"
                                                CornerRadius="4"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind Columns.ShowIp, Mode=OneWay}">
                                                <TextBlock
                                                    Text="{x:Bind IpText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Padding="8,2"
                                                CornerRadius="4"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind Columns.ShowDuration, Mode=OneWay}">
                                                <TextBlock
                                                    Text="{x:Bind DurationText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
